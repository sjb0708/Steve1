{
  "framework": "nextjs",
  "buildCommand": "prisma generate && prisma db push && next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/bookings/sync",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/reminders",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/reminders/evening",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/reminders/closing",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/price-evaluation/collect",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/market-analysis/collect",
      "schedule": "30 9 * * *"
    }
  ]
}
